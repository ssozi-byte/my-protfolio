---
// src/pages/projects.astro — full project list from the build-time collection.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubProjects from '../components/GitHubProjects.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Projects" description="Projects I've designed, built, and shipped.">
  <h1>Projects</h1>
  <p class="muted">
    Curated showcase from build-time content, plus live repo data your browser
    fetches directly from GitHub.
  </p>

  <div class="grid">
    {projects.map((p) => (
      <ProjectCard
        title={p.data.title}
        description={p.data.description}
        url={p.data.url}
        repo={p.data.repo}
        tags={p.data.tags}
        stars={p.data.stars}
      />
    ))}
  </div>

  <h2>Live from GitHub</h2>
  <GitHubProjects />
</BaseLayout>
