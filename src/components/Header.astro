---
// src/components/Header.astro — static nav, highlights the current page.
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">Your Name</a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.href.replace(/\/+$/, '') ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
