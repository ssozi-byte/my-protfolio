---
// src/pages/index.astro — static homepage.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubProjects from '../components/GitHubProjects.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <h1>Hi, I'm {SITE.author}.</h1>
    <p>
      I build fast, reliable things for the web. This site is 100% static — it
      loads instantly and cannot crash under traffic, because there is no server
      to crash.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/projects/">View projects</a>
      <a class="btn" href="/about/">About me</a>
    </div>
  </section>

  <h2>Selected work</h2>
  <div class="grid">
    {projects.map((p) => (
      <ProjectCard
        title={p.data.title}
        description={p.data.description}
        url={p.data.url}
        repo={p.data.repo}
        tags={p.data.tags}
        stars={p.data.stars}
      />
    ))}
  </div>

  <h2>Live from GitHub</h2>
  <GitHubProjects />
</BaseLayout>
