---
// src/components/ContactForm.astro
//
// Contact form with ZERO server code of ours. The <form> POSTs directly to
// Formspree's endpoint, which delivers the email — our host just serves HTML.
//
// Setup: create a free form at https://formspree.io, then paste the ID into
// src/content/config.ts (CONTACT.formspreeId). This component includes ~15
// lines of optional inline JS purely to show inline success/error messages
// instead of a redirect; remove the <script> and the form still works.
import { CONTACT } from '../config';

const endpoint = CONTACT.endpoint;
const configured = CONTACT.formspreeId !== 'YOUR_FORM_ID';
---

<div class="contact-form-wrap">
  {configured ? (
    <form class="contact-form" action={endpoint} method="POST">
      <label>
        Email
        <input type="email" name="email" placeholder="you@example.com" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" placeholder="Hi! I'd like to talk about…" required></textarea>
      </label>
      <!-- Honeypot field: bots fill it, humans never see it. Formspree ignores those. -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" />

      <button class="btn primary" type="submit">Send message</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  ) : (
    <p class="island-status">
      Contact form not configured yet. Set <code>CONTACT.formspreeId</code> in
      <code>src/content/config.ts</code>, or just email me directly.
    </p>
  )}
</div>

<script>
  // Optional inline enhancement only — the form works without JS via plain POST.
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const status = document.querySelector<HTMLElement>('.form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (status) status.textContent = 'Sending…';
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (status) {
        status.textContent = res.ok
          ? 'Thanks! Your message is on its way.'
          : 'Something went wrong — please email me directly.';
      }
      if (res.ok) form.reset();
    } catch {
      if (status) status.textContent = 'Network error — please email me directly.';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
