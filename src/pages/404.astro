    <h1>404 — page not found</h1>
    <p class="muted">Even static sites have dead ends. Let's get you back on track.</p>
    <div class="cta-row">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn" href="/projects/">See projects</a>
    </div>
  </section>
</BaseLayout>
